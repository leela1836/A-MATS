OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Market data (configs/market.yaml -> data_sources)
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
WS_API_KEY=

# Broker — paper (configs/trading.yaml -> mode.paper)
PAPER_API_KEY=
PAPER_API_SECRET=

# Broker — live (configs/trading.yaml -> mode.live) — leave blank until Phase 13
LIVE_API_KEY=
LIVE_API_SECRET=

# Data layer
DATABASE_URL=postgresql://user:password@localhost:5432/amats
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
