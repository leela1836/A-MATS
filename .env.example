# Copy to .env and fill in — .env is gitignored, never commit real keys.

# LLM Provider — set which one is active in configs/agent.yaml -> llm.provider
# Default provider is "google" (Gemini). Get a key from Google AI Studio.
GOOGLE_API_KEY=
# Only needed if you switch llm.provider to "openai" (requires funded account).
OPENAI_API_KEY=
# Only needed if you switch llm.provider to "nvidia" (NVIDIA NIM).
NVIDIA_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Market data — Indian market (configs/market.yaml -> data_sources)
# Yahoo Finance (NSE/BSE via .NS/.BO) and nsepython need no key.
GROWW_API_KEY=
GROWW_API_SECRET=
WS_API_KEY=

# Broker — paper is fully in-app (no external broker). These keys only matter
# for LIVE execution later (configs/trading.yaml -> mode). Default broker: Groww.
# Alternatives: Upstox, Angel One SmartAPI.
PAPER_API_KEY=
PAPER_API_SECRET=

# Broker — live (configs/trading.yaml -> mode.live) — leave blank until Phase 13
LIVE_API_KEY=
LIVE_API_SECRET=

# Data layer
DATABASE_URL=postgresql://user:password@localhost:5432/amats
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
